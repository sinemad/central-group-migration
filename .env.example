# Copy this file to .env and edit to match your environment.
# .env is gitignored — safe to store local overrides here.

# Host port the web UI is exposed on.
# Change this if 8000 conflicts with another container on your host.
HOST_PORT=8000

# Export directory — where exported group data is stored on the server.
# Must be an absolute path inside the container (mount it as a volume below).
# If unset, defaults to /app/exports inside the container.
# The directory can also be changed at runtime via the UI Settings (⚙) button.
# EXPORT_DIR=/data/central-exports
