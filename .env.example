# Copy this file to .env and edit to match your environment.
# .env is gitignored — safe to store local overrides here.

# ── Port ─────────────────────────────────────────────────────────────────────
# Host port the web UI is exposed on.
# Change this if 8000 conflicts with another container on your host.
HOST_PORT=8000

# ── Export / backup directories ───────────────────────────────────────────────
# macOS and Windows (Docker Desktop): leave these unset. Docker Desktop handles
# bind-mount permissions automatically — no path or uid/gid config needed.
#
# Linux (bare-metal or remote server):
#   Set EXPORT_HOME to redirect exports out of the project directory and into
#   your home directory (or any other writable path). Also set PUID/PGID so
#   the container user matches the owner of that directory.
#
#   Example — store data in your home directory:
#   EXPORT_HOME=/home/dan
#   BACKUP_HOME=/home/dan          # defaults to EXPORT_HOME value if omitted

# EXPORT_HOME=/home/dan
# BACKUP_HOME=/home/dan

# ── Linux only: container user identity ───────────────────────────────────────
# Only required when EXPORT_HOME is set to a directory outside the project
# folder (e.g. your home directory). The container user must match the owner
# of that directory or writes will fail with Permission denied.
# Not needed on macOS or Windows — Docker Desktop handles this transparently.
# Not needed on Linux when using the default ./exports path.
# Run `id` in your terminal to find the right values.
# PUID=1000
# PGID=1000

# ── Advanced ──────────────────────────────────────────────────────────────────
# Export directory path INSIDE the container. Only change this if you edit the
# right-hand side of the volume mount in docker-compose.yml.
# The directory can also be changed at runtime via the UI Settings (⚙) button.
# EXPORT_DIR=/app/exports
